rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny all unmapped paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User Profile Document
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId)
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.name is string && request.resource.data.name.size() <= 120
                    && request.resource.data.email is string && request.resource.data.email.size() <= 200;
      allow update: if isOwner(userId) && isValidId(userId)
                    && request.resource.data.userId == request.auth.uid;
      allow delete: if isOwner(userId) && isValidId(userId);

      // Subcollection: Saved Opportunities
      match /savedOpportunities/{oppId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(oppId)
                      && request.resource.data.userId == request.auth.uid;
        allow update: if isOwner(userId) && isValidId(oppId)
                      && request.resource.data.userId == request.auth.uid;
        allow delete: if isOwner(userId) && isValidId(oppId);
      }

      // Subcollection: Application Tracker Entries
      match /applications/{appId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(appId)
                      && request.resource.data.userId == request.auth.uid
                      && request.resource.data.role is string && request.resource.data.role.size() <= 200
                      && request.resource.data.organization is string && request.resource.data.organization.size() <= 200;
        allow update: if isOwner(userId) && isValidId(appId)
                      && request.resource.data.userId == request.auth.uid;
        allow delete: if isOwner(userId) && isValidId(appId);
      }

      // Subcollection: Resumes
      match /resumes/{resumeId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(resumeId)
                      && request.resource.data.userId == request.auth.uid;
        allow update: if isOwner(userId) && isValidId(resumeId)
                      && request.resource.data.userId == request.auth.uid;
        allow delete: if isOwner(userId) && isValidId(resumeId);
      }

      // Subcollection: Interview Preparation Progress
      match /interviewProgress/{questionId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(questionId)
                              && request.resource.data.userId == request.auth.uid;
        allow delete: if isOwner(userId) && isValidId(questionId);
      }

      // Subcollection: User Preferences
      match /preferences/{prefId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(prefId)
                              && request.resource.data.userId == request.auth.uid;
        allow delete: if isOwner(userId) && isValidId(prefId);
      }
    }
  }
}
